<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>Edit Directory Record</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/css/edit-styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
</head>

<body>
  <div class="edit-container">
    <div class="dir-summary-card" style="background:var(--primary-bg);border-radius:12px;padding:1.2rem 1.5rem 1rem 1.5rem;margin-bottom:2rem;box-shadow:0 1px 8px 0 rgba(31,143,241,0.06);border:1px solid var(--border);">
      <h1 style="margin-bottom:0.2rem;"><i class="fa-solid fa-folder-open"></i> <%= directory.name %></h1>
      <div style="color:var(--text-secondary);font-size:1.05rem;margin-bottom:0.5rem;"><i class="fa-solid fa-location-dot"></i> <strong>Path:</strong> <span style="color:var(--text-main);"><%= directory.path %></span></div>
      <div style="display:flex;gap:2rem;flex-wrap:wrap;font-size:1.02rem;">
        <div><strong>Parsed Name:</strong> <span data-field="parsedName"><%= directory.parsedName || 'N/A' %></span></div>
        <div><strong>Year:</strong> <span data-field="parsedYear"><%= directory.parsedYear || 'N/A' %></span></div>
        <div><strong>Type:</strong> <span data-field="parsedType"><%= directory.parsedType || 'N/A' %></span></div>
        <div><strong>Special:</strong> <span data-field="specialName"><%= directory.specialName || 'N/A' %></span></div>
        <div><strong>TMDB ID:</strong> <span data-field="tmdbId"><%= directory.tmdbId || 'N/A' %></span></div>
        <div><strong>Library:</strong> <span data-field="libraryAdded"><%= directory.libraryAdded ? 'Added' : 'Not Added' %></span></div>
        <div><strong>TMDB Status:</strong> <span data-field="tmdbStatus"><%= directory.tmdbStatus || 'N/A' %></span></div>
        <% if (directory.metadata) { %>
          <div>
            <strong>Metadata:</strong>
            <button type="button" onclick="toggleMetadata()" style="margin-left:0.5em;">Show/Hide</button>
            <pre id="metadata-json" style="display:none;background:var(--secondary-bg);padding:0.7em 1em;border-radius:8px;margin-top:0.5em;max-width:400px;overflow-x:auto;"><%= JSON.stringify(directory.metadata, null, 2) %></pre>
          </div>
          <script>
            function toggleMetadata() {
              const el = document.getElementById('metadata-json');
              el.style.display = (el.style.display === 'none') ? 'block' : 'none';
            }
          </script>
        <% } %>
      </div>
      <% if (directory.metadata && directory.metadata.unrated === true) { %>
        <span class="badge badge-unrated" style="background:#e74c3c;color:#fff;padding:0.3em 0.7em;border-radius:6px;margin-left:0.7em;font-size:0.95em;vertical-align:middle;">Unrated</span>
      <% } %>
    </div>
    <form id="edit-directory-form" action="/directory/<%= directory.id %>/edit" method="POST" style="margin-bottom:2.5rem;">
      <h2 style="margin-top:0.5rem;margin-bottom:1.2rem;font-size:1.3rem;color:var(--accent);"><i class="fa-solid fa-pen-to-square"></i> Edit Details</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
        <div>
          <label for="parsedName">Parsed Name</label>
          <input type="text" name="parsedName" id="parsedName" value="<%= directory.parsedName || '' %>">
        </div>
        <div>
          <label for="parsedYear">Parsed Year</label>
          <input type="number" name="parsedYear" id="parsedYear" value="<%= directory.parsedYear || '' %>">
        </div>
        <div>
          <label for="parsedType">Parsed Type</label>
          <select name="parsedType" id="parsedType">
            <option value="" <%=(directory.parsedType===null || directory.parsedType==='' ) ? 'selected' : '' %>>-- Select --</option>
            <option value="movies" <%=directory.parsedType==='movies' ? 'selected' : '' %>>Movies</option>
            <option value="sports-f1" <%=directory.parsedType==='sports-f1' ? 'selected' : '' %>>Formula 1</option>
            <option value="shows" <%=directory.parsedType==='shows' ? 'selected' : '' %>>Shows</option>
            <option value="collection" <%=directory.parsedType==='collection' ? 'selected' : '' %>>Collection</option>
          </select>
        </div>
        <div>
          <label for="specialName">Special Name</label>
          <input type="text" name="specialName" id="specialName" value="<%= directory.specialName || '' %>">
        </div>
        <div>
          <label for="tmdbId">TMDB ID</label>
          <input type="number" name="tmdbId" id="tmdbId" value="<%= directory.tmdbId || '' %>">
        </div>
        <div>
          <label for="tmdbStatus">TMDB Status</label>
          <select name="tmdbStatus" id="tmdbStatus">
            <option value="" <%=(directory.tmdbStatus===null || directory.tmdbStatus==='' ) ? 'selected' : '' %>>-- Select --</option>
            <option value="MATCH_FOUND" <%=directory.tmdbStatus==='MATCH_FOUND' ? 'selected' : '' %>>MATCH_FOUND</option>
            <option value="NO_MATCH_FOUND" <%=directory.tmdbStatus==='NO_MATCH_FOUND' ? 'selected' : '' %>>NO_MATCH_FOUND</option>
            <option value="API_DOWN" <%=directory.tmdbStatus==='API_DOWN' ? 'selected' : '' %>>API_DOWN</option>
            <option value="NETWORK_ERROR" <%=directory.tmdbStatus==='NETWORK_ERROR' ? 'selected' : '' %>>NETWORK_ERROR</option>
            <option value="SKIPPED_NO_PARSED_NAME" <%=directory.tmdbStatus==='SKIPPED_NO_PARSED_NAME' ? 'selected' : '' %>>SKIPPED_NO_PARSED_NAME</option>
          </select>
        </div>
        <div>
          <label for="libraryAdded">Library Added</label>
          <select name="libraryAdded" id="libraryAdded">
            <option value="" <%=(directory.libraryAdded===null) ? 'selected' : '' %>>-- Select --</option>
            <option value="true" <%=directory.libraryAdded===true ? 'selected' : '' %>>Yes</option>
            <option value="false" <%=directory.libraryAdded===false ? 'selected' : '' %>>No</option>
          </select>
        </div>
        <div>
          <label for="libraryPath">Library Path</label>
          <input type="text" name="libraryPath" id="libraryPath" value="<%= directory.libraryPath || '' %>">
        </div>
        <div>
          <label for="libraryId">Library</label>
          <select name="libraryId" id="libraryId">
            <option value="">-- None --</option>
            <% if (libraries && libraries.length) { %>
              <% libraries.forEach(function(lib) { %>
                <option value="<%= lib.id %>" <%= directory.libraryId===lib.id ? 'selected' : '' %>><%= lib.name %> (<%= lib.rootPath %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>
      </div>
      <div class="button-group" style="margin-top:2.5rem;justify-content:flex-end;">
        <button type="submit"><i class="fa-solid fa-floppy-disk"></i> Update Directory</button>
      </div>
    </form>
    <div class="button-group" style="justify-content:space-between;">
      <a class="button action-btn" href="#" data-url="/directory/<%= directory.id %>/parse"><i class="fa-solid fa-wand-magic-sparkles"></i> Parse</a>
      <a class="button action-btn" href="#" data-url="/directory/<%= directory.id %>/update-tmdb"><i class="fa-brands fa-imdb"></i> Update TMDB</a>
      <a class="button action-btn" href="#" data-url="/add-to-library/<%= directory.id %>"><i class="fa-solid fa-link"></i> Add to Library</a>
      <% if (directory.parsedType === 'movies') { %>
        <a class="button action-btn" href="#" data-url="/directory/<%= directory.id %>/check-explicit"><i class="fa-solid fa-eye-slash"></i> Check Explicit</a>
        <a class="button action-btn" href="#" data-url="/directory/<%= directory.id %>/mark-explicit" style="background:#e67e22;color:#fff;"><i class="fa-solid fa-triangle-exclamation"></i> Mark Explicit</a>
        <a class="button action-btn" href="#" data-url="/directory/<%= directory.id %>/clear-explicit" style="background:#27ae60;color:#fff;"><i class="fa-solid fa-eraser"></i> Clear Explicit</a>
      <% } %>
      <a class="button" href="/" style="background:var(--border);color:var(--text-main);"><i class="fa-solid fa-arrow-left"></i> Back to List</a>
    </div>
    <div class="action-buttons">
        <button class="btn btn-save" id="saveBtn">Save</button>
        <% if (directory.parsedType === 'movies') { %>
          <button class="btn btn-explicit" id="explicitBtn"><i class="fa-solid fa-eye-slash"></i> Check Explicit</button>
        <% } %>
        <button class="btn btn-delete" onclick="deleteDirectory('<%= directory.id %>', '<%= directory.libraryPath %>')" style="background:#e74c3c;color:#fff;padding:0.5em 0.6em;min-width:0;width:auto;" title="Delete Directory">
          <i class="fa-solid fa-trash" style="font-size:1.1em;"></i>
        </button>
      </div>
  </div>
  <!-- Modal dialog for API responses -->
  <div id="api-dialog" class="modal" style="display:none;">
    <div class="modal-content" style="background:var(--secondary-bg);color:var(--text-main);border-radius:12px;padding:2rem 2.5rem;box-shadow:0 2px 16px 0 rgba(31,143,241,0.12);border:1px solid var(--border);max-width:400px;margin:auto;">
      <span class="modal-close" onclick="closeDialog()" style="float:right;font-size:1.5rem;cursor:pointer;">&times;</span>
      <h2 id="api-dialog-title" style="margin-top:0;"></h2>
      <p id="api-dialog-message"></p>
    </div>
  </div>
  <script src="/js/edit-page.js"></script>
  <script>
    // Helper: Update summary fields in the UI
    function updateSummaryCard(data) {
      document.querySelector('[data-field="parsedName"]').textContent = data.parsedName || 'N/A';
      document.querySelector('[data-field="parsedYear"]').textContent = data.parsedYear || 'N/A';
      document.querySelector('[data-field="parsedType"]').textContent = data.parsedType || 'N/A';
      document.querySelector('[data-field="specialName"]').textContent = data.specialName || 'N/A';
      document.querySelector('[data-field="tmdbId"]').textContent = data.tmdbId || 'N/A';
      document.querySelector('[data-field="libraryAdded"]').textContent = data.libraryAdded ? 'Added' : 'Not Added';
      // Add TMDB Status update
      if (document.querySelector('[data-field="tmdbStatus"]')) {
        document.querySelector('[data-field="tmdbStatus"]').textContent = data.tmdbStatus || 'N/A';
      }
      // Fix: Only update metadata if the element exists
      const metadataEl = document.getElementById('metadata-json');
      if (metadataEl) {
        if (data.metadata) {
          metadataEl.textContent = JSON.stringify(data.metadata, null, 2);
          metadataEl.parentElement.style.display = '';
        } else {
          metadataEl.parentElement.style.display = 'none';
        }
      }
    }

    // AJAX action handler for Parse, Update TMDB, Add to Library
    document.querySelectorAll('.action-btn').forEach(btn => {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        // Prevent duplicate triggers
        if (btn.classList.contains('disabled')) return;
        btn.classList.add('disabled');
        const url = btn.getAttribute('data-url');
        showDialog('Processing...', 'Please wait...');
        try {
          const resp = await fetch(url, { method: 'POST', headers: { 'Accept': 'application/json' } });
          if (!resp.ok) throw new Error('Request failed');
          const data = await resp.json();
          updateSummaryCard(data);
          if (url.includes('check-explicit')) {
            const details = data.unrated_check ? JSON.stringify(data.unrated_check, null, 2) : 'No details';
            showDialog('Explicit Content Check', details);
          } else if (url.includes('mark-explicit')) {
            showDialog('Manual Override', 'Marked as Explicit');
          } else if (url.includes('clear-explicit')) {
            showDialog('Manual Override', 'Cleared Explicit flag');
          } else {
            showDialog('Success', 'Updated successfully');
          }
        } catch (err) {
          showDialog('Error', err.message || 'Failed');
        } finally {
          btn.classList.remove('disabled');
        }
      });
    });

    // AJAX handler for Update Directory form
    document.getElementById('edit-directory-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const form = e.target;
      const url = form.action;
      const formData = new FormData(form);
      const payload = {};
      formData.forEach((value, key) => { payload[key] = value; });
      showDialog('Processing...', 'Please wait...');
      try {
        const resp = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!resp.ok) throw new Error('Request failed');
        const data = await resp.json();
        updateSummaryCard(data);
        showDialog('Success', 'Directory updated successfully');
      } catch (err) {
        showDialog('Error', err.message || 'Failed');
      }
    });

    function showDialog(title, message, reloadAfter = false) {
      document.getElementById('api-dialog-title').textContent = title;
      document.getElementById('api-dialog-message').textContent = message;
      document.getElementById('api-dialog').style.display = 'block';
    }
    function closeDialog() {
      document.getElementById('api-dialog').style.display = 'none';
    }

    function deleteDirectory(id, libraryPath) {
      if (!confirm('Are you sure you want to delete this directory and its symlinks?')) return;
      fetch(`/directory/${id}/delete`, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ libraryPath })
      })
      .then(resp => resp.json())
      .then(data => {
        alert(data.message || 'Deleted');
        window.location.href = '/';
      })
      .catch(err => {
        alert('Delete failed: ' + (err.message || 'Unknown error'));
      });
    }
  </script>
</body>

</html>