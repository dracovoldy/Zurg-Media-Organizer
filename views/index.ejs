<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Directory Sync Status</title>
  <style>
      body { font-family: Arial, sans-serif; margin: 20px; }
      h1 { color: #333; }
      .directory { border: 1px solid #ccc; padding: 10px; border-radius: 4px; margin-bottom: 15px; }
      .filename { margin-left: 20px; }
      .tmdb { margin-top: 10px; display: flex; }
      .tmdb img { max-width: 150px; }
      .tmdb-details { margin-left: 20px; }
      .tmdb-status { color: red; margin-top: 10px; }
      
      /* Search form styling */
      .search-form { margin-bottom: 20px; }
      .search-form input, .search-form select {
          margin-right: 10px;
          padding: 5px;
      }
      .search-form button {
          padding: 5px 10px;
      }
      
      /* Pagination Floating Pill Styling */
      .pagination-container {
        position: fixed;
        bottom: 0;
        right: 20px;
        background: rgba(50, 50, 50, 0.8);
        border-radius: 50px;
        padding: 5px 10px;
        transform: translateY(90%);
        transition: transform 0.3s ease;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .pagination-container:hover {
        transform: translateY(0);
      }
      .pagination-container a.page-link {
        margin: 0 5px;
        padding: 8px 12px;
        text-decoration: none;
        background-color: #f0f0f0;
        color: #333;
        border-radius: 4px;
        transition: background-color 0.3s;
      }
      .pagination-container a.page-link:hover {
        background-color: #ccc;
      }
      .pagination-container a.page-link.active {
        font-weight: bold;
        background-color: #333;
        color: #fff;
      }
      
      /* Files collapse styling */
      .files { margin-top: 10px; }
      .toggle-btn {
        margin-top: 10px;
        padding: 5px 10px;
        background-color: #007BFF;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }

      /* New action buttons styling */
      .action-buttons {
        margin-top: 10px;
      }
      .action-buttons a.edit-btn {
        display: inline-block;
        margin-right: 10px;
        padding: 5px 10px;
        background-color: #28a745;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
      }
      .action-buttons a.edit-btn:hover {
        background-color: #218838;
      }
    </style>
</head>
<body>
  <h1>Synced Directories</h1>
  <!-- Search Form -->
  <form class="search-form" method="GET" action="/">
      <input type="text" name="name" placeholder="Directory Name" value="<%= query.name || '' %>" />
      <input type="text" name="parsedName" placeholder="Parsed Name" value="<%= query.parsedName || '' %>" />
      <input type="number" name="year" placeholder="Year" value="<%= query.year || '' %>" />
      <input type="text" name="specialName" placeholder="Special Name" value="<%= query.specialName || '' %>" />
      <input type="text" name="tmdbId" placeholder="TMDB ID" value="<%= query.tmdbId || '' %>" />
      <!-- New: Type Filter Dropdown -->
      <select name="type">
        <option value="">All Types</option>
        <option value="movies" <%= query.type === 'movies' ? 'selected' : '' %>>Movies</option>
        <option value="shows" <%= query.type === 'shows' ? 'selected' : '' %>>Shows</option>
        <option value="collection" <%= query.type === 'collection' ? 'selected' : '' %>>Collection</option>
        <option value="unknown" <%= query.type === 'unknown' ? 'selected' : '' %>>Unknown</option>
      </select>
      <!-- New: Library Status Filter Dropdown -->
      <select name="libraryStatus">
        <option value="">All Library Status</option>
        <option value="added" <%= query.libraryStatus === 'added' ? 'selected' : '' %>>Added</option>
        <option value="notAdded" <%= query.libraryStatus === 'notAdded' ? 'selected' : '' %>>Not Added</option>
      </select>
      <select name="sortBy">
        <option value="">Sort By</option>
        <% for (let i = 0; i < validSortFields.length; i++) { %>
          <option value="<%= validSortFields[i] %>" <%= query.sortBy === validSortFields[i] ? 'selected' : '' %>><%= validSortFields[i] %></option>
        <% } %>
      </select>
      <select name="sortOrder">
        <option value="desc" <%= query.sortOrder === 'desc' ? 'selected' : '' %>>Descending</option>
        <option value="asc" <%= query.sortOrder === 'asc' ? 'selected' : '' %>>Ascending</option>
      </select>
      <button type="submit">Search</button>
  </form>
  
  <% enrichedDirectories.forEach(function(dir) { %>
      <div class="directory">
          <h2><%= dir.name %></h2>
          <div><strong>Path:</strong> <%= dir.path %></div>
          <div><strong>Parsed Name:</strong> <%= dir.parsedName || 'N/A' %></div>
          <div><strong>Parsed Year:</strong> <%= dir.parsedYear ? dir.parsedYear : 'N/A' %></div>
          <div><strong>Parsed Type:</strong> <%= dir.parsedType || 'N/A' %></div>
          <div><strong>Special Name:</strong> <%= dir.specialName || 'N/A' %></div>
          <% if (dir.tmdbInfo) { %>
            <div class="tmdb">
                <img src="https://image.tmdb.org/t/p/w200/<%= dir.tmdbInfo.poster_path %>" alt="Poster">
                <div class="tmdb-details">
                    <div><strong>TMDB Title:</strong> <%= dir.tmdbInfo.title || dir.tmdbInfo.name %></div>
                    <div><strong>Release Date:</strong> <%= dir.tmdbInfo.release_date || dir.tmdbInfo.first_air_date %></div>
                    <div><strong>Overview:</strong> <%= dir.tmdbInfo.overview || 'N/A' %></div>
                </div>
            </div>
          <% } else { %>
            <div class="tmdb-status"><strong>TMDB Status:</strong> <%= dir.tmdbStatus || 'N/A' %></div>
          <% } %>

          <!-- Library status display -->
          <% if (dir.libraryAdded) { %>
            <div><strong>Library:</strong> Added (<%= dir.libraryPath %>)</div>
          <% } else { %>
            <div><strong>Library:</strong> Not Added</div>
          <% } %>
  
          <!-- Action Buttons Group -->
          <div class="action-buttons">
              <a class="edit-btn" href="/directory/<%= dir.id %>/edit">Edit Directory</a>
              <button class="toggle-btn" data-target="files-<%= dir.id %>">Show Files</button>
          </div>
          <div id="files-<%= dir.id %>" class="files" style="display:none;">
              <strong>Files:</strong>
              <ul>
                <% dir.files.forEach(function(file) { %>
                  <li class="filename"><%= file.name %> – <%= file.size %> bytes</li>
                <% }) %>
              </ul>
          </div>

      </div>
  <% }); %>
  
  <!-- Pagination Controls -->
  <div class="pagination-container">
      <% if (page > 1) { %>
         <a class="page-link" href="/?page=<%= page - 1 %>">Previous</a>
      <% } %>
      <% for (let i = 1; i <= totalPages; i++) { %>
         <a class="page-link <%= (i === page ? 'active' : '') %>" href="/?page=<%= i %>"><%= i %></a>
      <% } %>
      <% if (page < totalPages) { %>
         <a class="page-link" href="/?page=<%= page + 1 %>">Next</a>
      <% } %>
  </div>
  
  <!-- JS for toggling files -->
  <script>
    document.addEventListener("DOMContentLoaded", function(){
      document.querySelectorAll('.toggle-btn').forEach(button => {
        button.addEventListener('click', function(){
          var targetId = this.getAttribute("data-target");
          var fileContainer = document.getElementById(targetId);
          if (fileContainer.style.display === "none") {
            fileContainer.style.display = "block";
            this.textContent = "Hide Files";
          } else {
            fileContainer.style.display = "none";
            this.textContent = "Show Files";
          }
        });
      });
    });
  </script>
</body>
</html>