<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Media-Symlink Organizer</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.ico">
  <link rel="stylesheet" href="/css/index-styles.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
  <!-- <h1>Synced Directories</h1> -->

  <!-- Filter Accordion -->
  <div class="filter-accordion">
    <button class="accordion-toggle" type="button" aria-expanded="false" aria-controls="filter-panel" id="filter-toggle">Show Filters</button>
    <div id="filter-panel" class="accordion-panel" style="display:none;">
      <form class="search-form" method="GET" action="/">
        <!-- Library selector -->
        <label for="libraryId">Library:</label>
        <select name="libraryId" id="libraryId">
          <option value="">All Libraries</option>
          <% if (libraries && libraries.length) { %>
            <% libraries.forEach(function(lib) { %>
              <option value="<%= lib.id %>" <%= query.libraryId===lib.id ? 'selected' : '' %>><%= lib.name %> (<%= lib.rootPath %>) <%= lib.isDefault ? ' [default]' : '' %></option>
            <% }) %>
          <% } %>
        </select>
        <input type="text" name="name" placeholder="Directory Name" value="<%= query.name || '' %>" />
        <input type="text" name="parsedName" placeholder="Parsed Name" value="<%= query.parsedName || '' %>" />
        <input type="number" name="year" placeholder="Year" value="<%= query.year || '' %>" />
        <input type="text" name="specialName" placeholder="Special Name" value="<%= query.specialName || '' %>" />
        <input type="text" name="tmdbId" placeholder="TMDB ID" value="<%= query.tmdbId || '' %>" />
        <select name="type">
          <option value="">All Types</option>
          <option value="movies" <%=query.type==='movies' ? 'selected' : '' %>>Movies</option>
          <option value="shows" <%=query.type==='shows' ? 'selected' : '' %>>Shows</option>
          <option value="collection" <%=query.type==='collection' ? 'selected' : '' %>>Collection</option>
          <option value="unknown" <%=query.type==='unknown' ? 'selected' : '' %>>Unknown</option>
        </select>
        <select name="libraryStatus">
          <option value="">All Library Status</option>
          <option value="added" <%=query.libraryStatus==='added' ? 'selected' : '' %>>Added</option>
          <option value="notAdded" <%=query.libraryStatus==='notAdded' ? 'selected' : '' %>>Not Added</option>
        </select>
        <select name="sortBy">
          <option value="">Sort By</option>
          <% for (let i=0; i < validSortFields.length; i++) { %>
            <option value="<%= validSortFields[i] %>" <%=query.sortBy===validSortFields[i] ? 'selected' : '' %>><%= validSortFields[i] %></option>
          <% } %>
        </select>
        <select name="sortOrder">
          <option value="desc" <%=query.sortOrder==='desc' ? 'selected' : '' %>>Descending</option>
          <option value="asc" <%=query.sortOrder==='asc' ? 'selected' : '' %>>Ascending</option>
        </select>
        <button type="submit" class="btn btn-search">Search</button>
      </form>
    </div>
  </div>

  <!-- Create library form -->
  <div style="margin:1em 0;">
    <div style="float:right;margin-top:-2.2em;">
      <a href="/libraries-admin" class="btn">Libraries Admin</a>
    </div>
    <form id="create-library-form" onsubmit="event.preventDefault(); createLibrary();">
      <input type="text" id="newLibName" placeholder="Library name (e.g., Movies)" />
      <input type="text" id="newLibRoot" placeholder="Root path (e.g., /mnt/library)" />
      <label><input type="checkbox" id="newLibDefault" /> Default</label>
      <button class="btn" type="submit">Create Library</button>
    </form>
  </div>

  <!-- Mass Actions -->
  <div class="mass-actions">
    <!-- Changed from anchor to button with data attributes -->
    <!-- <button class="btn btn-mass btn-api" data-endpoint="/manual-sync" data-method="POST">Manual Sync</button> -->
    <button class="btn btn-mass btn-api" data-endpoint="/parse-all" data-method="GET">Parse All</button>
    <button class="btn btn-mass btn-api" data-endpoint="/update-all-tmdb" data-method="GET">Update TMDB All</button>
    <button class="btn btn-mass btn-api" data-endpoint="/add-to-library-mass" data-method="POST">Add All to Library</button>
  </div>

  <% enrichedDirectories.forEach(function(dir) { %>
    <div class="directory">
      <h2 class="dir-toggle" data-target="files-<%= dir.id %>" tabindex="0" role="button" aria-expanded="false">
        <%= dir.name %>
        <% if (dir.metadata && dir.metadata.unrated === true) { %>
          <span class="badge badge-unrated" style="background:#e74c3c;color:#fff;padding:0.3em 0.7em;border-radius:6px;margin-left:0.7em;font-size:0.95em;vertical-align:middle;">Unrated</span>
        <% } %>
      </h2>
      <div><strong>Path:</strong> <%= dir.path %></div>
      <div><strong>Parsed Name:</strong> <%= dir.parsedName || 'N/A' %></div>
      <div><strong>Parsed Year:</strong> <%= dir.parsedYear ? dir.parsedYear : 'N/A' %></div>
      <div><strong>Parsed Type:</strong> <%= dir.parsedType || 'N/A' %></div>
      <div><strong>Special Name:</strong> <%= dir.specialName || 'N/A' %></div>
      <% if (dir.tmdbInfo) { %>
        <div class="tmdb">
          <img src="https://image.tmdb.org/t/p/w200/<%= dir.tmdbInfo.poster_path %>" alt="Poster">
          <div class="tmdb-details">
            <div><strong>TMDB ID:</strong> <%= dir.tmdbId || 'N/A' %></div>
            <div><strong>TMDB Title:</strong> <%= dir.tmdbInfo.title || dir.tmdbInfo.name %></div>
            <div><strong>Release Date:</strong> <%= dir.tmdbInfo.release_date || dir.tmdbInfo.first_air_date %></div>
            <div><strong>Overview:</strong> <%= dir.tmdbInfo.overview || 'N/A' %></div>
          </div>
        </div>
      <% } else { %>
        <div class="tmdb-status"><strong>TMDB Status:</strong> <%= dir.tmdbStatus || 'N/A' %></div>
      <% } %>
      <% if (dir.libraryAdded) { %>
        <div><strong>Library:</strong> Added (<%= dir.libraryPath %>)</div>
      <% } else { %>
        <div><strong>Library:</strong> Not Added</div>
      <% } %>
      <div class="action-buttons">
        <button class="btn btn-edit" onclick="window.location.href='/directory/<%= dir.id %>/edit'">Edit Directory</button>
        <% if (dir.parsedType === 'movies') { %>
          <button class="btn btn-explicit" onclick="checkExplicit('<%= dir.id %>')"><i class="fa-solid fa-eye-slash"></i> Check Explicit</button>
        <% } %>
        <button class="btn btn-delete" onclick="deleteDirectory('<%= dir.id %>', '<%= dir.libraryPath %>')" style="background:#e74c3c;color:#fff;padding:0.5em 0.6em;min-width:0;width:auto;" title="Delete Directory">
          <i class="fa-solid fa-trash" style="font-size:1.1em;"></i>
        </button>
      </div>
      <div id="files-<%= dir.id %>" class="files" style="display:none;">
        <strong>Files:</strong>
        <ul>
          <% dir.files.forEach(function(file) { %>
            <li class="filename"><%= file.name %> – <%= file.size %> bytes</li>
          <% }) %>
        </ul>
      </div>
    </div>
  <% }); %>

  <!-- Pagination Controls -->
  <div class="pagination-container">
    <% 
      // Helper to build query string with updated page param
      function buildPageUrl(targetPage) {
        const params = [];
        for (const key in query) {
          if (key !== 'page' && query[key] !== undefined && query[key] !== '') {
            params.push(encodeURIComponent(key) + '=' + encodeURIComponent(query[key]));
          }
        }
        params.push('page=' + targetPage);
        return '/?' + params.join('&');
      }
    %>
    <% if (page > 1) { %>
      <a class="page-link" href="<%= buildPageUrl(page - 1) %>">Previous</a>
    <% } %>
    <% for (let i = 1; i <= totalPages; i++) { %>
      <a class="page-link <%= (i === page ? 'active' : '') %>" href="<%= buildPageUrl(i) %>">
        <%= i %>
      </a>
    <% } %>
    <% if (page < totalPages) { %>
      <a class="page-link" href="<%= buildPageUrl(page + 1) %>">Next</a>
    <% } %>
  </div>

  <!-- Modal dialog for API responses -->
  <div id="api-dialog" class="modal">
    <div class="modal-content">
      <span class="modal-close" onclick="closeDialog()">&times;</span>
      <h2 id="api-dialog-title"></h2>
      <p id="api-dialog-message"></p>
    </div>
  </div>

  <!-- JS for API calls and toggling files -->
  <script src="/js/index-page.js"></script>
  <script>
    function checkExplicit(id) {
      const url = `/directory/${id}/check-explicit`;
      document.getElementById('api-dialog-title').textContent = 'Processing...';
      document.getElementById('api-dialog-message').textContent = 'Please wait...';
      document.getElementById('api-dialog').style.display = 'block';
      fetch(url, { method: 'POST', headers: { 'Accept': 'application/json' } })
        .then(resp => resp.json())
        .then(data => {
          document.getElementById('api-dialog-title').textContent = 'Explicit Content Check';
          document.getElementById('api-dialog-message').textContent = JSON.stringify(data.unrated_check, null, 2);
        })
        .catch(err => {
          document.getElementById('api-dialog-title').textContent = 'Error';
          document.getElementById('api-dialog-message').textContent = err.message || 'Failed';
        });
    }
    function deleteDirectory(id, libraryPath) {
      if (!confirm('Are you sure you want to delete this directory and its symlinks?')) return;
      fetch(`/directory/${id}/delete`, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ libraryPath })
      })
      .then(resp => resp.json())
      .then(data => {
        alert(data.message || 'Deleted');
        window.location.reload();
      })
      .catch(err => {
        alert('Delete failed: ' + (err.message || 'Unknown error'));
      });
    }
  </script>
</body>

</html>