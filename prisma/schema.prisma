// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Directory {
  id           String   @id @default(uuid()) // Generates a UUID for each new Directory record
  name         String
  path         String   @unique
  parsedName   String? // Additional property: parsed directory name
  parsedYear   Int? // Additional property: parsed directory year
  parsedType   String? // Additional property: type extracted from directory name
  specialName  String? // Additional property: any special name extracted from directory
  tmdbId       Int? // TMDB id if found
  tmdbStatus   String? // Status of TMDB matching process (e.g., MATCH_FOUND, NO_MATCH_FOUND, API_DOWN, NETWORK_ERROR)
  libraryAdded Boolean  @default(false) // Indicates if added to library
  libraryPath  String? // Path to the library folder
  createdAt    DateTime @default(now())
  // Stored as a stringified JSON blob for SQLite compatibility in this workspace.
  // If you have a database that supports Json (Postgres/MySQL), you can revert this to `Json?`.
  metadata     String?  // Arbitrary JSON metadata (stringified)
  files        File[]
}

model File {
  id          String     @id @default(uuid()) // Generates a UUID for each new File record
  name        String
  path        String     @unique
  size        BigInt
  createdAt   DateTime   @default(now())
  directory   Directory? @relation(fields: [directoryId], references: [id])
  directoryId String?
}
