{
  "name": "4bhi-media-org",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "pm2 start index.js --name Zurg-Organizer",
    "dev": "nodemon ./index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:backup": "bash ./scripts/db-backup.sh",
    "db:generate": "npx prisma generate",
    "db:reset": "npx prisma migrate reset --force --skip-seed",
    "db:reset:seed": "npx prisma migrate reset --force && npm run seed",
    "db:reset:backup": "npm run db:backup && npm run db:reset",
    "db:reset:backup:seed": "npm run db:backup && npm run db:reset:seed",
    "seed": "node prisma/seed.js || true",
    "ui:dev": "cd next-app && npm run dev",
    "ui:build": "cd next-app && npm run build",
    "ui:start": "cd next-app && npm run start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.38.5",
    "@prisma/client": "^6.5.0",
    "bottleneck": "^2.19.5",
    "chokidar": "^4.0.3",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
  "cors": "^2.8.5",
    "node-fetch": "^3.3.2",
    "openai": "^5.19.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
